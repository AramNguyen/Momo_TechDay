# Copy thành .env.local khi chạy máy, và khai báo y chang trong Vercel > Settings > Environment Variables

# Claude API (console.anthropic.com). NHỚ đặt spend limit trong console.
ANTHROPIC_API_KEY=
# Mặc định claude-sonnet-5-5. Muốn rẻ hơn thì đổi sang claude-haiku-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5

# Supabase > Project Settings > API (dùng service_role key, CHỈ để ở server)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram: tạo bot bằng @BotFather
TELEGRAM_BOT_TOKEN=
# Chuỗi ngẫu nhiên tự đặt, dùng khi setWebhook (chỉ chữ, số, _ và -)
TELEGRAM_WEBHOOK_SECRET=
# Username bot (không có @), để hiện nút "Chat với Bà trên Telegram"
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Link web sau khi deploy, vd https://ba-ngoai-ai.vercel.app
NEXT_PUBLIC_SITE_URL=

# Trần số lượt gọi Claude mỗi ngày (toàn hệ thống)
DAILY_CLAUDE_CAP=2000

# Vercel Cron tự gửi header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
